{
  "name": "waymark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "VITE_API_URL=https://waymark.bocas-joshua.workers.dev vite",
    "build": "tsc -b && vite build",
    "build:remote": "VITE_API_URL=https://waymark.bocas-joshua.workers.dev npm run build",
    "test:lib": "tsx src/lib/apiBase.test.ts && tsx src/lib/workoutRecovery.test.ts && tsx src/lib/trainingReality.test.ts && tsx src/lib/sessionSuggestions.test.ts && tsx src/lib/sessionReviewAI.test.ts && tsx src/lib/hrAnalysis.test.ts && tsx src/lib/starterStatus.test.ts && tsx src/server/routes/strava.test.ts && tsx src/lib/ledgerInsightsAI.test.ts && tsx src/lib/roadBootcampTemplate.test.ts && tsx src/lib/roadBootcampStrengthTemplates.test.ts && tsx src/lib/roadBootcampMetrics.test.ts && tsx src/lib/historyHrMetrics.test.ts",
    "smoke:offline-review": "node scripts/smoke-offline-session-review.mjs",
    "smoke:foundation-run": "node scripts/smoke-foundation-run.mjs",
    "smoke:live-review": "node scripts/smoke-live-session-review.mjs",
    "smoke:road-reset": "node scripts/smoke-road-bootcamp-reset.mjs",
    "smoke:road-week": "node scripts/smoke-road-week-generation.mjs",
    "smoke:road-strength": "node scripts/smoke-road-strength-matrix.mjs",
    "smoke:road-strength-complete": "node scripts/smoke-road-strength-completion.mjs",
    "smoke:road-run": "node scripts/smoke-road-run-flow.mjs",
    "smoke:road-remote": "node scripts/smoke-road-remote-readiness.mjs",
    "deploy": "npx wrangler deploy",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:remote": "npm run build:remote && vite preview",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:devices": "xcrun devicectl list devices",
    "ios:doctor": "node scripts/ios-device-doctor.mjs",
    "ios:build:generic": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS' CODE_SIGNING_ALLOWED=NO -skipPackageUpdates build",
    "ios:build:device": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination \"id=${WAYMARK_IOS_DEVICE_ID}\" -allowProvisioningUpdates -allowProvisioningDeviceRegistration build",
    "ios:open": "npx cap open ios",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "npx wrangler d1 execute waymark-db --local --file=./drizzle/0001_open_supernaut.sql",
    "db:migrate:remote": "npx wrangler d1 execute waymark-db --remote --file=./drizzle/0001_open_supernaut.sql",
    "db:migrate:0011:local": "npx wrangler d1 execute waymark-db --local --file=./drizzle/0011_skip_reason.sql",
    "db:migrate:0011:remote": "npx wrangler d1 execute waymark-db --remote --file=./drizzle/0011_skip_reason.sql",
    "db:migrate:0019:local": "npx wrangler d1 execute waymark-db --local --file=./drizzle/0019_static_stretch_warmup.sql",
    "db:migrate:0019:remote": "npx wrangler d1 execute waymark-db --remote --file=./drizzle/0019_static_stretch_warmup.sql",
    "db:migrate:0020:local": "npx wrangler d1 execute waymark-db --local --file=./drizzle/0020_manual_apr22_run.sql",
    "db:migrate:0020:remote": "npx wrangler d1 execute waymark-db --remote --file=./drizzle/0020_manual_apr22_run.sql",
    "db:migrate:0022:local": "npx wrangler d1 execute waymark-db --local --file=./drizzle/0022_road_bootcamp.sql",
    "db:migrate:0022:remote": "npx wrangler d1 execute waymark-db --remote --file=./drizzle/0022_road_bootcamp.sql",
    "db:migrate:0023:local": "npx wrangler d1 execute waymark-db --local --file=./drizzle/0023_training_reality.sql",
    "db:migrate:0023:remote": "npx wrangler d1 execute waymark-db --remote --file=./drizzle/0023_training_reality.sql",
    "db:seed:generate": "tsx src/db/seed.ts",
    "db:seed:local": "npx wrangler d1 execute waymark-db --local --file=./src/db/seed.sql",
    "db:seed:remote": "npx wrangler d1 execute waymark-db --remote --file=./src/db/seed.sql",
    "db:demo:seed:generate": "tsx scripts/write-demo-seed.ts",
    "db:demo:wipe:local": "npx wrangler d1 execute waymark-db --local --file=./src/db/demoWipe.sql",
    "db:demo:wipe:remote": "npx wrangler d1 execute waymark-db --remote --file=./src/db/demoWipe.sql",
    "db:demo:seed:local": "npx wrangler d1 execute waymark-db --local --file=./src/db/demoSeed.sql",
    "db:demo:seed:remote": "npx wrangler d1 execute waymark-db --remote --file=./src/db/demoSeed.sql",
    "db:demo:migrate:remote": "for f in ./drizzle/*.sql; do npx wrangler d1 execute waymark-demo-db --remote --file=\"$f\"; done",
    "db:demo:seed:demo": "npx wrangler d1 execute waymark-demo-db --remote --file=./src/db/demoSeed.sql",
    "db:demo:deploy": "npx wrangler deploy --config wrangler.demo.jsonc",
    "db:start:seed:generate": "tsx src/db/startSeed.ts",
    "db:start:seed:local": "npx wrangler d1 execute waymark-db --local --file=./src/db/startSeed.sql",
    "db:start:seed:remote": "npx wrangler d1 execute waymark-db --remote --file=./src/db/startSeed.sql",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@base-ui/react": "^1.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource-variable/cinzel": "^5.2.8",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.9",
    "lucide-react": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "patch-package": "^8.0.1",
    "shadcn": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wrangler": "^4.78.0"
  }
}
