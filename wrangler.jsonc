{
	"name": "waymark",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "waymark-db",
			"database_id": "93509b7f-2a0b-420c-8e80-f2b1aebd771d"
		}
	],
	// 03:00 America/Los_Angeles (10:00 UTC) — nightly reactive replan window.
	// Reads state as-of run time and makes at most one silent week adjustment.
	"triggers": {
		"crons": ["0 10 * * *"]
	}
	// Secret bindings (set via `wrangler secret put`):
	//   ANTHROPIC_API_KEY            - Anthropic API key for AI calls
	//   STRAVA_CLIENT_ID             - Strava app client id (226927)
	//   STRAVA_CLIENT_SECRET         - Strava app client secret
	//   STRAVA_WEBHOOK_VERIFY_TOKEN  - random string Strava echoes on subscription verify
}