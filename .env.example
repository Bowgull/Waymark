# Copy to .env for local values. Never commit .env.
# Vite vars must be prefixed with VITE_.

APP_NAME=Waymark
APP_BUNDLE_ID=com.joshbocas.app

GITHUB_REPO_URL=
GITHUB_DEFAULT_BRANCH=main

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=waymark
CLOUDFLARE_D1_BINDING=DB
CLOUDFLARE_D1_DATABASE_NAME=waymark-db
CLOUDFLARE_D1_DATABASE_ID=

LOCAL_DEV_URL=http://localhost:5173
PRODUCTION_API_URL=
STAGING_API_URL=

# Optional: Wrangler / CI (do not commit real tokens)
# CLOUDFLARE_API_TOKEN=

SENTRY_DSN=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=

ONEPACE_URL=https://onepace.net

APPLE_TEAM_ID=
APPLE_BUNDLE_ID=

# Frontend → API during Vite dev (Worker runs separately on :8787 unless proxied)
VITE_API_URL=http://localhost:8787
# Production (Capacitor / prod build): use your workers.dev origin, no trailing slash — never commit real secrets in .env
# VITE_API_URL=https://your-subdomain.workers.dev

# Shared secret for Worker auth. Must match WAYMARK_API_KEY Worker secret (set via `wrangler secret put WAYMARK_API_KEY`).
VITE_API_KEY=
