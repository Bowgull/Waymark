{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "codex/roadtrip-coach": true,
      "claude/*": false,
      "injury-weather": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://bridgefour.xyz https://*.vercel.app"
        }
      ]
    }
  ]
}
